rules_version = '2';

// Reglas de Cloud Storage for Firebase para CI Quality Group.
//
// Único uso hoy: fotos del control de ingreso/salida de material
// (`material_entries/{entryId}/{material|origin}.jpg`).
//
// IMPORTANTE — por qué NO usamos `firestore.get()`/`firestore.exists()`
// acá: en un principio estas reglas ataban el acceso al rol (admin/hours)
// y, más adelante, también al dueño + ventana de 24h del doc en
// `material_entries`, consultando Firestore desde Storage Rules vía la
// función cross-service documentada por Firebase. Esa función COMPILA
// sin error (`firebase deploy` la acepta), pero probado en runtime contra
// este proyecto (subida real vía la API REST de Storage, con un ID token
// real de un usuario `hours`) siempre devuelve `permission-denied`,
// incluso en el caso más simple (rol + doc inexistente). No se identificó
// la causa exacta — puede ser una limitación de la plataforma para este
// proyecto en particular. Dado que es una función central para poder usar
// la app (sin esto nadie puede subir una foto), se optó por NO depender
// de ella: el control de acceso real por rol vive en `firestore.rules`
// (`material_entries` solo lee/escribe admin/hours). Acá solo exigimos
// sesión autenticada — el `entryId` es un id de Firestore autogenerado
// (~20 caracteres al azar), así que un rol sin acceso a `material_entries`
// no tiene forma práctica de enumerar o adivinar qué fotos existen.
//
// Si en el futuro se quiere retomar el atado a dueño/ventana, probar
// primero con una regla mínima igual a esta vía la API REST antes de
// asumir que funciona — no confiar solo en que "compiló bien".
//
// Para desplegar tras editar:
//   firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {
    match /material_entries/{entryId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // Aparte de `create`/`update`: en `delete` no existe
      // `request.resource` (no hay contenido nuevo), así que validar
      // tamaño/tipo ahí siempre falla. `deleteEntry()` en el repo
      // depende de este permiso para limpiar las fotos al borrar un
      // movimiento.
      allow delete: if request.auth != null;
    }
  }
}
