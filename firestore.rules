rules_version = '2';

// Reglas de seguridad de Firestore para CI Quality Group.
//
// Patrón de seguridad: cada usuario autenticado tiene un doc en
// /users/{uid} con un `role` (admin | sales | hours) y un flag `active`.
// Los helpers de abajo leen ese doc para autorizar cada operación.
//
// Para desplegar tras editar:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userDoc().role;
    }

    function isActive() {
      return userDoc().get('active', true) == true;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin' && isActive();
    }

    function isSales() {
      return isSignedIn() && role() == 'sales' && isActive();
    }

    function isHours() {
      return isSignedIn() && role() == 'hours' && isActive();
    }

    function isAuditor() {
      return isSignedIn() && role() == 'auditor' && isActive();
    }

    function isCajero() {
      return isSignedIn() && role() == 'cajero' && isActive();
    }

    // ---------- Delegación caja (modo excepción) ----------
    // Singleton en `settings/sales_delegation`. Cuando está vigente, las
    // reglas de `sales/{sid}/payments` permiten al rol sales registrar el
    // pago en el mismo submit de la venta (ver Fase 2 para ese cambio).
    // La vigencia REAL combina `active` + ventana [startsAt..expiresAt].
    // Firestore cachea `get()`/`exists()` dentro de una misma evaluación,
    // así que las llamadas múltiples no multiplican la facturación.
    function delegationDoc() {
      return get(/databases/$(database)/documents/settings/sales_delegation);
    }

    function delegationExists() {
      return exists(/databases/$(database)/documents/settings/sales_delegation);
    }

    function delegationActive() {
      return delegationExists()
        && delegationDoc().data.active == true
        && (
          !('startsAt' in delegationDoc().data)
          || delegationDoc().data.startsAt == null
          || request.time >= delegationDoc().data.startsAt
        )
        && (
          !('expiresAt' in delegationDoc().data)
          || delegationDoc().data.expiresAt == null
          || request.time < delegationDoc().data.expiresAt
        );
    }

    // ---------- Users ----------
    // Cada usuario lee su propio perfil (necesario para arrancar la app
    // y resolver el rol). Admin lee y escribe todos los perfiles.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ---------- Workers (trabajadores operativos) ----------
    // Todos los autenticados leen (el encargado de horas necesita la
    // lista). Solo admin crea/edita/desactiva.
    match /workers/{wid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- Sales ----------
    // Admin, sales, cajero y auditor leen. Auditor: solo lectura (su
    // dashboard muestra ventas filtradas por su `auditFilter`; el
    // filtrado real lo hace la app cliente con .where()).
    //
    // - Admin: control total.
    // - Sales: crea solicitudes; solo puede editar las suyas mientras
    //   estén dentro de la ventana fija de 24 h desde `createdAt`. La
    //   ventana NO se reinicia al editar (editableUntil se fija al crear
    //   y nunca se reasigna). No puede tocar campos financieros ni el
    //   state — eso lo bloquea el cliente.
    // - Cajero: actualiza el workflow (state) y agregados de pago
    //   (paidAmount, lossAmount, etc.). No puede borrar.
    // Las validaciones detalladas de "qué campo puede tocar qué rol"
    // se hacen en cliente; las rules dejan el guard rail grueso para
    // que el rol incorrecto no pueda escribir nunca.
    match /sales/{sid} {
      allow read: if isAdmin() || isSales() || isCajero() || isAuditor();
      allow create: if isAdmin() || isSales();
      allow update: if isAdmin()
        || isCajero()
        || (isSales()
            && resource.data.createdBy == request.auth.uid
            && resource.data.get('editableUntil', request.time) > request.time);
      allow delete: if isAdmin();

      // ---------- Payments (subcolección) ----------
      // Lectura: admin y cajero siempre; sales solo los payments que
      // ella misma registró (necesario para que el sales-side
      // SaleDetailScreen muestre el payment de delegación recién creado).
      // Borrado: solo admin (anular un pago se modela como delete +
      // recalculo del padre en una transacción).
      // Creación: cajero/admin siempre; sales solo cuando la delegación
      // caja está vigente y el payload viene marcado con
      // `createdViaDelegation: true` + `registeredBy == auth.uid`. El
      // flag actúa como guard: si sales intentara crear un payment sin
      // él, se rechaza aunque la delegación esté activa.
      match /payments/{pid} {
        allow read: if isAdmin()
          || isCajero()
          || (isSales() && resource.data.registeredBy == request.auth.uid);
        allow create: if request.resource.data.amount is number
          && request.resource.data.amount > 0
          && (
            isAdmin() || isCajero()
            || (
              isSales()
              && delegationActive()
              && request.resource.data.registeredBy == request.auth.uid
              && request.resource.data.createdViaDelegation == true
            )
          );
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ---------- Payments — collection group ----------
    // Permiso explícito para `collectionGroup('payments')`. El admin
    // dashboard lo usa para agregar el desglose por método de pago real
    // sobre todas las subcolecciones a la vez (Firestore exige una
    // regla con wildcard `{path=**}` además del match específico). El
    // match anterior cubre las operaciones puntuales (lectura por
    // venta, create, delete); este cubre la query agregada.
    match /{path=**}/payments/{pid} {
      allow read: if isAdmin()
        || isCajero()
        || (isSales() && resource.data.registeredBy == request.auth.uid);
    }

    // ---------- Hours entries ----------
    // Hours y admin pueden leer y registrar horas. Solo admin borra.
    match /hours_entries/{hid} {
      allow read: if isAdmin() || isHours();
      allow create, update: if isAdmin() || isHours();
      allow delete: if isAdmin();
    }

    // ---------- Master lists ----------
    // Todos los autenticados leen (dropdowns en sales y workers).
    // Admin tiene control total (create/update/delete sin restricciones).
    // Sales y hours solo pueden CREAR items como sugerencias
    // (`userSuggested == true`); el admin las aprueba después editándolas
    // o las puede borrar.
    match /master_lists/{listId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /items/{itemId} {
        allow read: if isSignedIn();
        allow create: if isAdmin()
          || (isSignedIn()
              && request.resource.data.get('userSuggested', false) == true);
        allow update, delete: if isAdmin();
      }
    }

    // ---------- Counters (consecutivo CQG-XXX / ING-XXX / SAL-XXX) ----------
    // Genérico: admin + sales, EXCEPTO los dos contadores de material
    // (esos tienen su match propio más abajo, solo admin + hours).
    // Firestore combina reglas con OR — sin el `cid != ...` de acá,
    // sales seguiría teniendo acceso a esos dos vía este match genérico
    // aunque no le corresponda (mismo patrón de "combina con OR" que
    // `settings/cash_register`, pero acá va en la otra dirección: hay
    // que RESTAR explícitamente, no sumar).
    match /counters/{cid} {
      allow read, write: if (isAdmin() || isSales())
        && cid != 'material_entries_consecutive'
        && cid != 'material_exits_consecutive';
    }
    match /counters/material_entries_consecutive {
      allow read, write: if isAdmin() || isHours();
    }
    match /counters/material_exits_consecutive {
      allow read, write: if isAdmin() || isHours();
    }

    // ---------- Settings (jornada laboral, delegación caja, …) ----------
    // Lectura para todos los autenticados (el calculador de horas y
    // varias pantallas leen la jornada; sales lee `sales_delegation`
    // para saber si su form debe mostrar campos de pago). Escritura
    // solo admin.
    match /settings/{sid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Historial append-only de la delegación caja. Cada activación o
    // desactivación crea una entry desde el repo en una runTransaction
    // junto con el set del singleton padre. Visible solo para admin;
    // nadie puede editar ni borrar entries (auditoría).
    //
    // El check de `keys().hasAll(...)` garantiza que toda entry traiga
    // los campos mínimos para auditoría — sin esto, alguien con permiso
    // de admin podría inyectar entries malformadas vía API directa.
    match /settings/sales_delegation/history/{hid} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                      && request.resource.data.actorUid == request.auth.uid
                      && request.resource.data.keys().hasAll(
                        ['action', 'actorUid', 'actorName', 'at'],
                      );
      allow update, delete: if false;
    }

    // ---------- Cierre de caja (estado singleton) ----------
    // Estado runtime de la caja en `settings/cash_register`. La abren y
    // cierran cajero y admin; la lee cualquier autenticado (el banner
    // global "caja abierta" se muestra en todos los roles). El genérico
    // settings/{sid} solo da write a admin; este match SUMA write a cajero
    // (Firestore combina reglas con OR). La config con la hora de cierre
    // vive en settings/cash_register_config y queda admin-only por la regla
    // genérica — no necesita match propio.
    match /settings/cash_register {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isCajero();
    }

    // ---------- Cierre de caja (ledger de turnos) ----------
    // Append-only. Cajero/admin crean el turno (status open) y lo cierran
    // (único update permitido: solo mientras está open). Un turno cerrado
    // es inmutable — `resource.data.status == 'open'` en el update lo
    // garantiza. Lectura solo caja/admin (no sales, no auditor).
    match /cash_shifts/{shiftId} {
      allow read: if isAdmin() || isCajero();
      allow create: if (isAdmin() || isCajero())
                      && request.resource.data.status == 'open';
      allow update: if (isAdmin() || isCajero())
                      && resource.data.status == 'open';
      allow delete: if isAdmin();
    }

    // ---------- Notifications (bell in-app) ----------
    // Colección plana de notifs con target por uid y/o por rol. Firestore
    // no permite OR en `where`, así que cada cliente hace dos queries
    // paralelas y mergea. Los repos de sales y cashier las escriben en
    // la misma transacción que produce el evento.
    //
    // - Lee/actualiza: solo si la notif te apunta (por uid o por rol).
    //   El update está limitado a tocar SOLO el array `readBy` para que
    //   un usuario pueda marcarla como leída pero no editar el contenido.
    // - Crea: cualquier autenticado, siempre que `createdBy == uid` (la
    //   regla evita que alguien suplante el actor). Limita el spam a las
    //   acciones reales que el código emite.
    // - Borra: solo admin (cleanup manual; no hay TTL).
    match /notifications/{id} {
      function isTargetUser() {
        return isSignedIn()
            && (request.auth.uid in resource.data.get('targetUids', [])
                || role() in resource.data.get('targetRoles', []));
      }
      allow read: if isTargetUser();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isTargetUser()
                    && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['readBy']);
      allow delete: if isAdmin();
    }

    // ---------- Material entries (control de ingreso/salida de material) ----------
    // Admin y hours registran movimientos con fotos (subidas antes a
    // Storage — ver storage.rules). Mismo criterio de ventana de edición
    // que sales/hours_entries: 24h fijas desde `createdAt`, nunca se
    // reasigna. Independiente de `sales` — decisión explícita de Carlos.
    //
    // `materialPhotoUrl`/`originPhotoUrl` deben ser download URLs reales
    // de Storage — sin esto, alguien con acceso a la API cruda (no el
    // formulario) podría meter un string arbitrario ahí, que después
    // termina sin escapar de más en el `<img src>` del correo a
    // gerencia (el cliente Dart también escapa, pero esto es la
    // barrera del lado del servidor).
    function isStorageUrl(url) {
      return url is string
        && url.matches('https://firebasestorage\\.googleapis\\.com/.*');
    }
    match /material_entries/{id} {
      allow read: if isAdmin() || isHours();
      allow create: if (isAdmin() || isHours())
        && request.resource.data.type in ['ingreso', 'salida']
        && isStorageUrl(request.resource.data.materialPhotoUrl)
        && (
          !('originPhotoUrl' in request.resource.data)
          || request.resource.data.originPhotoUrl == null
          || isStorageUrl(request.resource.data.originPhotoUrl)
        );
      // `type` y `consecutive` son inmutables una vez creado el doc —
      // el consecutivo (ING-/SAL-) ya codifica el tipo, así que dejar
      // cambiar uno sin el otro desincroniza el dashboard y el correo.
      allow update: if (isAdmin()
            || (isHours()
                && resource.data.createdBy == request.auth.uid
                && resource.data.get('editableUntil', request.time) > request.time))
        && request.resource.data.type == resource.data.type
        && request.resource.data.consecutive == resource.data.consecutive;
      allow delete: if isAdmin();
    }

    // ---------- Mail (consume la extensión firestore-send-email) ----------
    // El cliente solo puede ENCOLAR un correo — nunca leerlo, editarlo ni
    // borrarlo (eso lo gestiona la extensión, que corre con privilegios
    // de admin y no pasa por estas rules). `hasOnly` evita que se cuelen
    // campos extra (ej. un `from` que suplante el remitente configurado).
    // Además, `to` debe ser subconjunto de los destinatarios que el admin
    // configuró en `settings/material_notifications` — sin esto, un
    // admin/hours con acceso a la API cruda podría usar el Gmail de la
    // empresa para mandarle correo a cualquier dirección arbitraria.
    function allowedMailRecipients() {
      return exists(/databases/$(database)/documents/settings/material_notifications)
        ? get(/databases/$(database)/documents/settings/material_notifications)
            .data.get('recipientEmails', [])
        : [];
    }
    match /mail/{id} {
      allow read: if false;
      allow create: if (isAdmin() || isHours())
        && request.resource.data.keys().hasOnly(['to', 'message'])
        && request.resource.data.to is list
        && request.resource.data.to.size() > 0
        && request.resource.data.to.hasOnly(allowedMailRecipients())
        && request.resource.data.message.subject is string
        && request.resource.data.message.html is string;
      allow update, delete: if false;
    }

  }
}
